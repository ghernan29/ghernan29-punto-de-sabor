# ─────────────────────────────────────────────────────────────
# Punto de Sabor — environment variables
# Copy this file to .env.local and fill in your values.
# All NEXT_PUBLIC_* variables are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# WhatsApp number in international format, DIGITS ONLY (no +, spaces or dashes)
# Example for Mexico: country code 52 + 1 + 10-digit number
NEXT_PUBLIC_WHATSAPP_NUMBER=5215512345678

# Ordering rules
NEXT_PUBLIC_DELIVERY_FEE=35
NEXT_PUBLIC_MINIMUM_ORDER=100

# Localization / currency (optional, sensible defaults provided)
NEXT_PUBLIC_LOCALE=es-MX
NEXT_PUBLIC_CURRENCY_CODE=MXN
NEXT_PUBLIC_CURRENCY_SYMBOL=$
NEXT_PUBLIC_BUSINESS_NAME=Punto de Sabor
