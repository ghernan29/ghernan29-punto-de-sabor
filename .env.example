# ──────────────────────────────────────────────────────────────────────
# Punto de Sabor — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.
# ──────────────────────────────────────────────────────────────────────

# Supabase (https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Número de WhatsApp del negocio (formato internacional, solo dígitos: ej. 5215512345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=5215512345678

# Configuración de entrega
# Costo de envío fijo (en la moneda del menú, ej. MXN)
NEXT_PUBLIC_DELIVERY_FEE=35
# Pedido mínimo para realizar una orden
NEXT_PUBLIC_MIN_ORDER=120
# Símbolo / código de moneda mostrado en la UI
NEXT_PUBLIC_CURRENCY=MXN
# Locale para formatear precios
NEXT_PUBLIC_LOCALE=es-MX

# Nombre del negocio (override opcional; por defecto: "Punto de Sabor")
NEXT_PUBLIC_BUSINESS_NAME=Punto de Sabor
