# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# WhatsApp — country code + number, no + or spaces (e.g. 525512345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=525512345678

# Delivery settings (numbers in your currency, e.g. MXN)
NEXT_PUBLIC_DELIVERY_FEE=35
NEXT_PUBLIC_MINIMUM_ORDER=150

# Optional: site URL for PWA manifest (Vercel sets this automatically in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
